LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Moss — semantic search / memory (https://docs.moss.dev/docs)
# MOSS_PROJECT_ID / MOSS_PROJECT_KEY are filled in at index/run time (Task 9).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_LEADS_INDEX_NAME=leads
MOSS_MODEL_ID=moss-minilm

# Supabase — source of truth for companies/leads (book_meeting / log_outcome write here)
SUPABASE_URL=
SUPABASE_PUB_KEY=
SUPABASE_SECRET_KEY=

# Outbound calling — LiveKit SIP over a Twilio Elastic SIP trunk.
# Create the trunk once: `lk sip outbound create` (Twilio <name>.pstn.twilio.com + number),
# then `lk sip outbound list` for the ST_ id. Auth = your Twilio SIP trunk credentials.
SIP_OUTBOUND_TRUNK_ID=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
